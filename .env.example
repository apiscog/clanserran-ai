# Privada. URL de conexión PostgreSQL de Neon (usa la conexión pooled para Vercel).
DATABASE_URL=postgresql://usuario:contrasena@ep-ejemplo-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Privada y opcional. Base Neon vacía e independiente, solo para pruebas de integración.
# Nunca reutilices DATABASE_URL ni una variante pooled/directa de la misma base.
TEST_DATABASE_URL=postgresql://usuario_pruebas:contrasena@ep-pruebas-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Privada. Genera al menos 32 bytes aleatorios: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-por-un-secreto-largo-y-aleatorio

# URL pública canónica, sin barra final. En local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Privadas. Credenciales OAuth 2.0 de tipo "Aplicación web".
GOOGLE_CLIENT_ID=000000000000-ejemplo.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-ejemplo
